* text=auto eol=lf

# extern/minhook is upstream v1.3.4 byte for byte apart from the one change
# THIRD-PARTY-NOTICES.md records. Normalising its line endings means the tree no
# longer hashes to upstream's, and diffing it against upstream is the only way
# to audit what gets compiled in and confirm that change is still the only one.
# vendor/ is deliberately NOT listed: its DLL is already covered by *.dll binary
# below, and its README.md is generated by update-deps rather than copied from
# upstream.
extern/** -text
*.cmd text eol=crlf
*.bat text eol=crlf
*.dll binary
